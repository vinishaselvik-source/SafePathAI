# SAROS Emergency Operating System Environment Configuration
PORT=5000
NODE_ENV=development

# Optional Live Firebase Configuration
# If omitted or left empty, SAROS runs with its built-in resilient local data store!
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server Firebase Admin SDK (optional for production cloud deployments)
FIREBASE_SERVICE_ACCOUNT_KEY=
